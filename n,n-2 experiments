  return poly

#number of connected components in the decreasing forest 
def r(P):
    roots = P.decreasing_roots()
    return len(list(roots))

def s(P):
    b = P.upper_dyck_word()
    return b.number_of_touch_points()

#dinv of the upper dyck path
def dinv(P):
  return t^(P.upper_dyck_word()).dinv()

#distance
def d(P):
  return q^(P.number_of_tamari_inversions())

def g(n,k_1,k_2):
  TIP = TamariIntervalPosets(n)
  poly = 0
  for P in TIP:
    #print(s(P))
    if r(P) == k_1 and s(P) == k_2:
      poly = poly + dinv(P)*d(P)
  return poly

