def sum_between(i1,i2,alpha):
  tot = 0
  for j in range(i1,i2):
    tot = tot + alpha[j]
  return tot

def is_valid(alpha,beta,lambda):
  reversed = lambda[::-1]
  if alpha[0]>1+sum_between(0,reversed[0]):
    return False
  for i in range(1,len(alpha)):
    i1 = reversed[i-1]+1
    i2 = reversed[i]
    if alpha[i]>1+sum_between(i1,i2,beta):
      return False
  if alpha[-1]>1+sum_between(reversed[-1]+1,len(beta)):
    return False
  return True
      
